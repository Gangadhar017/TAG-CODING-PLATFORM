# TAG Coding Platform - Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=tagDB

# Server
PORT=8000
NODE_ENV=production

# CORS - comma-separated list of allowed origins
# In production set this to your frontend domain: https://your-app.onrender.com
# For local dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# JWT Secrets - use strong random strings in production
ACCESS_TOKEN_SECRET=replace_with_strong_random_secret_here
REFRESH_TOKEN_SECRET=replace_with_different_strong_random_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary (for avatar uploads) - optional but recommended
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
